{
  "version": 1,
  "languages": [
    "no",
    "en"
  ],
  "notes": {
    "no": "Disse testene verifiserer struktur og UI-flyt, ikke full samsvarsvurdering.",
    "en": "These tests verify structure and UI flow, not full compliance assessment."
  },
  "cases": [
    {
      "id": "mixed-atex-iecex-associated-gas",
      "title": {
        "no": "ATEX + IECEx med associated-del",
        "en": "ATEX + IECEx with associated section"
      },
      "input": {
        "markingText": "Ex db [ia IIC Ga] IIB T4 Gb IP55\nII 2 (1) G",
        "selectedSystems": [
          "atex",
          "iecex"
        ]
      },
      "expected": {
        "systems": [
          "atex",
          "iecex"
        ],
        "sections": {
          "iecex": {
            "fullLine": "Ex db [ia IIC Ga] IIB T4 Gb IP55",
            "tokens": [
              "Ex db",
              "[",
              "ia",
              "IIC",
              "Ga",
              "]",
              "IIB",
              "T4",
              "Gb",
              "IP55"
            ],
            "associatedTokens": [
              "ia",
              "IIC",
              "Ga"
            ],
            "mainTokens": [
              "Ex db",
              "IIB",
              "T4",
              "Gb"
            ],
            "otherTokens": [
              "IP55"
            ]
          },
          "atex": {
            "fullLine": "II 2 (1) G",
            "tokens": [
              "Ex",
              "II",
              "2",
              "(1)",
              "G"
            ]
          }
        }
      }
    },
    {
      "id": "legacy-dust-line",
      "title": {
        "no": "Eldre støvmerking",
        "en": "Legacy dust marking"
      },
      "input": {
        "markingText": "II 2 D Ex tD A21 IP65 T90°C",
        "selectedSystems": [
          "other"
        ]
      },
      "expected": {
        "systems": [
          "other"
        ],
        "preserveFullLine": true,
        "mustNotInventModernEquivalent": true
      }
    },
    {
      "id": "ocr-noise-filter",
      "title": {
        "no": "OCR-søppel rundt EX-merking",
        "en": "OCR noise around EX marking"
      },
      "input": {
        "ocrText": "R. STAHL HMI Systems GmbH\nTel +49 12345\nEx db [ia IIC Ga] IIB T4 Gb IP55\nII 2 (1) G\nFax +49 67890"
      },
      "expected": {
        "markingText": "Ex db [ia IIC Ga] IIB T4 Gb IP55\nII 2 (1) G",
        "discardManufacturerText": true,
        "discardPhoneText": true
      }
    },
    {
      "id": "unknown-token",
      "title": {
        "no": "Ukjent kode skal ikke gjettes",
        "en": "Unknown code must not be guessed"
      },
      "input": {
        "markingText": "Ex db XYZ IIB T4 Gb",
        "selectedSystems": [
          "iecex"
        ]
      },
      "expected": {
        "unknownTokens": [
          "XYZ"
        ],
        "mustShowUnknown": true,
        "mustNotAutoCorrect": true
      }
    },
    {
      "id": "atex-symbol-not-ocr-text",
      "title": {
        "no": "ATEX-symbol skal ikke OCR-leses",
        "en": "ATEX symbol is not OCR text"
      },
      "input": {
        "ocrText": "Ex db [ia IIC Ga] IIB T4 Gb IP55\nIECEx ABC 06.0012\nII 2 (I) G\nABC 00 ATEX 4012"
      },
      "expected": {
        "markingText": "Ex db [ia IIC Ga] IIB T4 Gb IP55\nII 2 (I) G",
        "systems": [
          "iecex",
          "atex"
        ],
        "atexSymbolSource": "ui-asset-not-ocr",
        "mustRenderAtexSymbolWhenAtexSectionParsed": true
      }
    },
    {
      "id": "selected-atex-without-parsed-atex",
      "title": {
        "no": "Valgt ATEX skal ikke gi falsk ATEX-resultat",
        "en": "Selected ATEX must not create a false ATEX result"
      },
      "input": {
        "markingText": "Ex db [ia IIC Ga] IIB T4 Gb IP55",
        "selectedSystems": [
          "atex",
          "iecex"
        ]
      },
      "expected": {
        "parsedSystems": [
          "iecex"
        ],
        "mustNotSayAtexFound": true
      }
    },
    {
      "id": "multiple-ex-lines-and-ce",
      "title": {
        "no": "Flere EX-linjer og CE-merking",
        "en": "Multiple EX lines and CE marking"
      },
      "input": {
        "ocrText": "II 2 (2) G Ex d e mb ib [ib] [op is] IIC T4\nII 2 D Ex tD A21 IP65 T90°C\nCE 0158\nTÜV 05 ATEX 7176 X"
      },
      "expected": {
        "mustReadWholePlate": true,
        "mustKeepMultipleRelevantLines": true,
        "ce": "CE 0158",
        "mustNotStopAfterFirstExLine": true
      }
    },
    {
      "id": "stahl-atex-ii-misread-as-11-or-il",
      "title": {
        "no": "R. STAHL-skilt – II kan leses som 11/Il",
        "en": "R. STAHL plate – II may be read as 11/Il"
      },
      "input": {
        "ocrText": "R. STAHL HMI Systems GmbH\nCE 0158\nTUV 05 ATEX 7176 X\n11 2 (2) G Ex d e mb ib [ib] [op is] IIC T4\nIl 2 D Ex tD A21 IP65 T90°C"
      },
      "expected": {
        "systems": [
          "atex"
        ],
        "mustFindTwoAtexCategoryLines": true,
        "atexCandidatesPreserveRawText": [
          "11 2 (2) G",
          "Il 2 D"
        ],
        "mustWarnAboutAmbiguousEquipmentGroup": true,
        "mustNotSilentlyConvert11OrIlToII": true,
        "ce": "CE 0158",
        "atexCertificateContains": "ATEX 7176 X"
      }
    },
    {
      "id": "context-aware-II-normalization",
      "title": {
        "no": "11/II normaliseres kun i kjent EX-kontekst",
        "en": "11/II normalized only in known EX context"
      },
      "input": {
        "markings": [
          "Ex db 11B T4 Gb",
          "Ex ia 11C Ga",
          "Ex tb 111C T90°C Db",
          "11 2 (2) G",
          "11 2 D"
        ]
      },
      "expected": {
        "normalized": [
          "Ex db IIB T4 Gb",
          "Ex ia IIC Ga",
          "Ex tb IIIC T90°C Db",
          "II 2 (2) G",
          "II 2 D"
        ],
        "mustNotGloballyReplace11": true
      }
    },
    {
      "id": "staged-reading-and-I-like-glyphs",
      "title": {
        "no": "Tre parserpass og I-lignende tegn",
        "en": "Three parser passes and I-like glyphs"
      },
      "input": {
        "imageText": "R. STAHL HMI Systems GmbH\n|| 2 (|) G Ex d e mb ib [ib] [op is] ||C T4\n!1 2 D Ex tD A21 IP65 T90°C\nCE 0158\nTUV 05 ATEX 7176 X"
      },
      "expected": {
        "passOrder": [
          "iecex",
          "atex",
          "other"
        ],
        "markingContains": [
          "Ex d e mb ib [ib] [op is] IIC T4",
          "Ex tD A21 IP65 T90°C",
          "II 2 (1) G",
          "II 2 D"
        ],
        "metadataContains": [
          "CE 0158",
          "ATEX 7176 X"
        ],
        "uppercaseIEquivalentGlyphsInKnownContext": [
          "I",
          "i",
          "l",
          "1",
          "|",
          "!"
        ],
        "mustNotGloballyReplaceGlyphs": true
      }
    },
    {
      "id": "richer-clickable-explanations",
      "title": {
        "no": "Mer forklaring på klikkbare koder",
        "en": "Richer explanations for clickable codes"
      },
      "expected": {
        "T4MentionsMaxSurfaceTemperatureC": 135,
        "GbMentionsZone": 1,
        "AtexCategory2MentionsZones": [
          1,
          21
        ],
        "BracketExplainsAssociatedPart": true,
        "XExplainsSpecialConditions": true,
        "DirectDustTemperatureSupported": "T125°C"
      }
    },
    {
      "id": "whole-plate-collapsed-to-one-line",
      "title": {
        "no": "Hele skiltet lest som én lang linje",
        "en": "Whole plate recognized as one long line"
      },
      "input": {
        "imageText": "|| 2 (|) G Ex d e mb ib [ib] [op is] ||C T4 !1 2 D Ex tD A21 IP65 T90°C CE 0158 TUV 05 ATEX 7176 X"
      },
      "expected": {
        "markingLines": [
          "Ex d e mb ib [ib] [op is] IIC T4",
          "Ex tD A21 IP65 T90°C",
          "II 2 (1) G",
          "II 2 D"
        ],
        "metadata": [
          "CE 0158",
          "TUV 05 ATEX 7176 X"
        ],
        "mustExtractAllOccurrences": true,
        "mustNotStopAfterFirstEx": true,
        "mustNotStopAfterFirstAtex": true
      }
    },
    {
      "id": "intrinsic-safety-i-like-glyphs",
      "title": {
        "no": "ia/ib/ic tåler I-lignende tegn i kjent Ex-kontekst",
        "en": "ia/ib/ic tolerate I-like glyphs in known Ex context"
      },
      "input": {
        "markings": [
          "Ex !a ||C T4 Ga",
          "Ex |b IIB T4 Gb",
          "Ex 1c IIA T4 Gc",
          "Ex db [!a ||C Ga] IIB T4 Gb"
        ]
      },
      "expected": {
        "normalized": [
          "Ex ia IIC T4 Ga",
          "Ex ib IIB T4 Gb",
          "Ex ic IIA T4 Gc",
          "Ex db [ia IIC Ga] IIB T4 Gb"
        ],
        "iLikeGlyphs": [
          "I",
          "i",
          "l",
          "1",
          "|",
          "!"
        ],
        "mustNotGloballyReplace": true
      }
    },
    {
      "id": "ip-rating-dynamic-interpretation",
      "title": {
        "no": "IP-grad tolkes som sammensatt kode",
        "en": "IP rating interpreted as a composed code"
      },
      "input": {
        "tokens": [
          "IP55",
          "IP65",
          "IP67",
          "IP68",
          "IP69K",
          "IPX4"
        ]
      },
      "expected": {
        "firstCharacter": "solid/contact protection",
        "secondCharacter": "water protection",
        "supportsX": true,
        "supportsSuffixK": true
      }
    }
  ]
}