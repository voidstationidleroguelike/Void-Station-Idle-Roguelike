          "Ex ib IIB Gb",
          "Ex ic IIA Gc",
          "Ex db [ia IIC Ga] IIB T4 Gb",
          "Ex d e mb ib [ib] [op is] IIC T4"
        ]
      }
    },
    {
      "id": "manual-partial-atex-group",
      "title": {
        "no": "Manuell ATEX kan tolkes før linjen er komplett",
        "en": "Manual ATEX can be interpreted before the line is complete"
      },
      "input": {
        "markingText": "II",
        "selectedSystems": [
          "atex"
        ],
        "manual": true
      },
      "expected": {
        "systems": [
          "atex"
        ],
        "tokens": [
          "Ex",
          "II"
        ],
        "mustInterpretPartial": true,
        "knownTokens": [
          "II"
        ]
      }
    },
    {
      "id": "square-brackets-preserved",
      "title": {
        "no": "Klammeparentes beholdes samlet",
        "en": "Square brackets are preserved as one structure"
      },
      "input": {
        "markingText": "II 2 (2) G Ex d e mb ib [ib] [op is] IIC T4",
        "selectedSystems": [
          "atex"
        ],
        "manual": true
      },
      "expected": {
        "tokens": [
          "Ex",
          "II",
          "2",
          "(2)",
          "G",
          "Ex",
          "d",
          "e",
          "mb",
          "ib",
          "[ib]",
          "[op is]",
          "IIC",
          "T4"
        ],
        "mustKeepSquareBracketsWhole": true,
        "mustKeepParenthesizedCategorySeparate": true,
        "mustNotCreateTokens": [
          "[op",
          "is]"
        ]
      }
    },
    {
      "id": "parentheses-vs-square-brackets",
      "title": {
        "no": "Runde og firkantede parenteser har forskjellig betydning",
        "en": "Round and square brackets have different meaning"
      },
      "input": {
        "markingText": "II 2 (1) G Ex db [ia IIC Ga] IIB T4 Gb",
        "selectedSystems": [
          "atex"
        ],
        "manual": true
      },
      "expected": {
        "roundParenthesisToken": "(1)",
        "squareBracketToken": "[ia IIC Ga]",
        "roundMeaning": "atex-associated-category",
        "squareMeaning": "associated-marking-section"
      }
    },
    {
      "id": "manual-never-uses-ocr-normalization",
      "title": {
        "no": "Manuell tekst bruker aldri OCR-korrigering",
        "en": "Manual text never uses OCR correction"
      },
      "input": {
        "markingText": "Ex !b I1C T4",
        "selectedSystems": [
          "iecex"
        ],
        "inputMode": "manual"
      },
      "expected": {
        "preservedTokens": [
          "Ex",
          "!b",
          "I1C",
          "T4"
        ],
        "mustNotNormalize": {
          "!b": "ib",
          "I1C": "IIC"
        }
      }
    },
    {
      "id": "manual-round-parenthesis-preserved",
      "title": {
        "no": "(I) må aldri bli (1) ved manuell innskriving",
        "en": "(I) must never become (1) in manual input"
      },
      "input": {
        "markingText": "II 2 (I) G",
        "selectedSystems": [
          "atex"
        ],
        "inputMode": "manual"
      },
      "expected": {
        "mustContainToken": "(I)",
        "mustNotContainToken": "(1)",
        "mustPreserveLiteralInput": true
      }
    },
    {
      "id": "bracket-description-adds-inner-meaning",
      "title": {
        "no": "Klammet kode viser kodeforklaring og klammeforklaring sammen",
        "en": "Bracketed code shows code meaning and bracket context together"
      },
      "input": {
        "tokens": [
          "[ib]",
          "[op is]",
          "[ia IIC Ga]"
        ]
      },
      "expected": {
        "mustKeepWholeTokens": true,
        "descriptionContainsInnerCodeMeaning": true,
        "descriptionContainsBracketContext": true,
        "mustNotTreatBracketsAsSeparateCode": true
      }
    }
  ]
